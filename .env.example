# SQLite for local dev. To move to production, swap this for a Postgres
# connection string (e.g. from Neon/Supabase/Railway) and change the
# provider in prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# Generate a real secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_a_random_32_byte_secret
NEXTAUTH_URL=http://localhost:3000
